{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start RFPM Mzuzu Portal",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "next-dev",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "next dev",
					"endsPattern": "Ready in"
				}
			}
		}
	]
}